# ==========================================
# 🤖 SURYA ROBO PORTFOLIO
# Git Ignore Configuration
# ==========================================

# ------------------------------------------
# 🖥️ Operating System Files
# ------------------------------------------

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini


# ------------------------------------------
# 💻 IDE / Editor Files
# ------------------------------------------

# Visual Studio Code
.vscode/
*.code-workspace

# Eclipse
.project
.classpath
.settings/

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/.nb-gradle/

# Sublime Text
*.sublime-workspace
*.sublime-project


# ------------------------------------------
# ☕ Java / Maven / Gradle
# ------------------------------------------

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Java compiled files
*.class
*.jar
*.war
*.ear

# Java crash logs
hs_err_pid*
replay_pid*


# ------------------------------------------
# 🔐 Environment & Secret Files
# ------------------------------------------

.env
.env.*
!.env.example

*.secret
*.secrets
secrets/
credentials/
config.local.*


# ------------------------------------------
# 🔑 API Keys / Private Configuration
# ------------------------------------------

*api-key*
*apikey*
*secret-key*
*private-key*
*credentials*
service-account*.json


# ------------------------------------------
# 🗄️ Database / Local Data
# ------------------------------------------

*.db
*.sqlite
*.sqlite3

# SQL dump files
*.sql.bak
*.dump


# ------------------------------------------
# 🧪 Testing / Coverage
# ------------------------------------------

coverage/
.nyc_output/
*.lcov


